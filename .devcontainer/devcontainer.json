{
  "name": "Reservas Pro (.NET 10 + PostgreSQL)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/reservas-pro",
  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csdevkit", "humao.rest-client"]
    }
  },
  "forwardPorts": [5015],
  "portsAttributes": {
    "5015": { "label": "Reservas Pro (panel y API)", "onAutoForward": "openBrowser" }
  },
  // La clave de firma de los JWT se genera al crear el contenedor; nunca se guarda en el repositorio
  "postCreateCommand": "dotnet restore ReservasPro.slnx && dotnet user-secrets set Jwt:Clave \"$(openssl rand -base64 48)\" --project src/ReservasPro.Api"
}
