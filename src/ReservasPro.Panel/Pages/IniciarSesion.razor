@page "/login"
@attribute [AllowAnonymous]
@inject ApiPanel Api
@inject SesionActual Sesion
@inject NavigationManager Navegacion

<PageTitle>Iniciar sesión · Reservas Pro</PageTitle>

<section class="tarjeta login">
    <h1>Panel del negocio</h1>
    <p class="suave">Administra tus citas, servicios y horarios.</p>

    <EditForm Model="modelo" OnValidSubmit="Entrar" FormName="login">
        <DataAnnotationsValidator />

        <label for="email">Correo</label>
        <InputText id="email" type="email" autocomplete="username" @bind-Value="modelo.Email" />
        <ValidationMessage For="() => modelo.Email" />

        <label for="clave">Contraseña</label>
        <InputText id="clave" type="password" autocomplete="current-password" @bind-Value="modelo.Clave" />
        <ValidationMessage For="() => modelo.Clave" />

        <Aviso Mensaje="@error" />

        <button class="boton" type="submit" disabled="@enviando">@(enviando ? "Entrando…" : "Entrar")</button>
    </EditForm>
</section>

@code {
    private readonly Login modelo = new();
    private string? error;
    private bool enviando;

    private async Task Entrar()
    {
        enviando = true;
        error = null;
        try
        {
            await Sesion.IniciarAsync(await Api.IniciarSesionAsync(modelo));
            Navegacion.NavigateTo("");
        }
        catch (ErrorDeApi e)
        {
            error = e.Message;
        }
        finally
        {
            enviando = false;
        }
    }
}
